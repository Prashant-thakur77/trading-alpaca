# Trading Alpaca — Environment Variables
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# PAPER ACCOUNT ONLY. Never put live-trading keys here.

# ── Alpaca (paper trading) ───────────────────────────────
# Keys from https://app.alpaca.markets/ (paper account dashboard).
# Variable names follow the official alpaca-mcp-server README.
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_PAPER_TRADE=True

# Optional endpoint overrides (leave unset for defaults)
# TRADE_API_URL=
# TRADE_API_WSS=
# DATA_API_URL=
# STREAM_DATA_WSS=

# ── Kill switch ──────────────────────────────────────────
# Set KILL=1 (or create a KILL_SWITCH file in the repo root) to halt all trading.
# KILL=0
